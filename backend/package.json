{
  "name": "recall-people-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev:node": "tsx watch src/server.ts",
    "dev": "bash ../scripts/dev/ensure-dev-postgres.sh && tsx watch --env-file=.dev.vars src/server.ts",
    "dev:workers": "wrangler dev --ip 0.0.0.0",
    "deploy": "dotenv -e .env.production -- prisma migrate deploy && prisma generate && wrangler deploy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:refresh-dev": "bash ../scripts/dev/refresh-dev-db.sh",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:avatar-image": "node --test test/avatar-image.test.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.56",
    "@ai-sdk/cerebras": "^2.0.2",
    "@ai-sdk/openai": "^3.0.12",
    "@ai-sdk/xai": "^3.0.1",
    "@anthropic-ai/sdk": "^0.24.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@hono/node-server": "^1.13.7",
    "@langfuse/tracing": "^4.5.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@posthog/ai": "^8.2.1",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "ai": "^6.0.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "groq-sdk": "^0.37.0",
    "hono": "^4.4.0",
    "jose": "^6.1.3",
    "langfuse": "^3.38.6",
    "pg": "^8.13.1",
    "posthog-node": "^5.38.2",
    "tsx": "^4.19.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.0",
    "prisma": "^5.22.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.60.0"
  }
}
