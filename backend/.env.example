# Database
DATABASE_URL=postgresql://user:password@host:5432/recall_people

# JWT Secret (512 bits recommended)
JWT_SECRET=your-super-secure-jwt-secret-here-minimum-64-characters-for-512-bits

# Account sync encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SYNC_ENCRYPTION_KEY=base64-encoded-32-byte-key

# API Keys
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
XAI_API_KEY=your-xai-grok-api-key
CEREBRAS_API_KEY=your-cerebras-api-key

# Speech-to-Text Provider Configuration
# Options: 'groq-whisper-v3' or 'groq-whisper-v3-turbo' (default, recommended)
# - groq-whisper-v3: Uses OpenAI Whisper Large v3 via Groq (best accuracy)
# - groq-whisper-v3-turbo: Uses Whisper v3 Turbo via Groq (8x faster, recommended)
STT_PROVIDER=groq-whisper-v3-turbo

# AI Text Provider Configuration
# Options: 'cerebras' (default), 'openai', or 'grok'
# - cerebras: Cerebras gpt-oss-120b (recommended text provider)
# - openai: OpenAI GPT-5 mini
# - grok: xAI Grok-4-1-fast model
# Recommended: Use 'cerebras' for app text analysis disclosures
AI_PROVIDER=cerebras

# Performance Logging
# Set to 'true' to enable detailed performance metrics logging in console
# Logs provider, model, duration, input/output sizes for all AI/STT calls
# Useful for comparing provider performance and optimizing
ENABLE_PERFORMANCE_LOGGING=false

# Google OAuth
GOOGLE_CLIENT_ID_WEB=your-google-client-id-web
GOOGLE_CLIENT_ID_IOS=your-google-client-id-ios
GOOGLE_CLIENT_ID_ANDROID=your-google-client-id-android

# Sign in with Apple account deletion
# Create a Sign in with Apple key in the Apple Developer portal. Preserve PEM
# newlines or encode them as literal \\n sequences in the deployment environment.
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-sign-in-with-apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
APPLE_CLIENT_ID=com.monkeycs60.recallpeople2026

# Admin Access
ADMIN_EMAIL=your-admin-email@example.com

# PostHog — LLM observability ($ai_generation on every AI call) + error tracking
# EU project. Leave POSTHOG_KEY empty to fully disable (no-op, best-effort).
# Get the project API key in PostHog → Project settings.
POSTHOG_KEY=phc_your_project_api_key
POSTHOG_HOST=https://eu.i.posthog.com
