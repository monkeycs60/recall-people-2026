# PostHog analytics + session replay (client-side, EU project).
# Public write-only key — safe to expose in the built client bundle.
# Set these at build time (Coolify build-time env vars for the landing service).
PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Pour marquer ce navigateur comme interne en production, ouvrir une fois la
# landing avec ?posthog_internal=1 (et ?posthog_internal=0 pour annuler).
