---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Recall People" description="Reset your Recall People password.">
  <main class="min-h-screen page-shell text-foreground flex flex-col">
    <div class="flex-1 flex items-center justify-center pt-24">
      <div class="max-w-lg mx-auto w-full">
        <div class="bg-surface rounded-2xl shadow-sm p-8">
          <div id="rp-content">
            {/* Suspense fallback equivalent: spinner shown until the client script renders the right state. */}
            <div class="flex flex-col items-center justify-center text-center px-6 py-16">
              <div class="w-8 h-8 border-3 border-primary border-t-transparent rounded-full animate-spin"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <Footer />
  </main>
</Layout>

<script>
  const DEEP_LINK_SCHEME = "recall-people://";
  const DEEP_LINK_DELAY_MS = 1500;

  const mount = document.getElementById("rp-content");
  const params = new URLSearchParams(window.location.search);
  const token = params.get("token");

  function noTokenView(): string {
    return `
      <div class="flex flex-col items-center justify-center text-center px-6 py-16">
        <div class="w-20 h-20 rounded-full bg-red-100 flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-text-primary mb-3">Invalid reset link</h1>
        <p class="text-text-secondary max-w-md mb-8">
          This password reset link is invalid or has expired. Please request a new one from the app.
        </p>
      </div>`;
  }

  function openingView(): string {
    return `
      <div class="flex flex-col items-center justify-center text-center px-6 py-16">
        <div class="w-20 h-20 rounded-full bg-primary-light flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-text-primary mb-3">Opening Recall People...</h1>
        <p class="text-text-secondary max-w-md mb-8">
          You should be redirected to the app automatically.
        </p>
        <div class="w-8 h-8 border-3 border-primary border-t-transparent rounded-full animate-spin"></div>
      </div>`;
  }

  function attemptedView(): string {
    return `
      <div class="flex flex-col items-center justify-center text-center px-6 py-16">
        <div class="w-20 h-20 rounded-full bg-primary-light flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-text-primary mb-3">Reset your password</h1>
        <p class="text-text-secondary max-w-md mb-8">
          Tap the button below to open Recall People and set your new password.
          Make sure the app is installed on your device.
        </p>
        <button
          id="rp-open"
          class="bg-primary hover:bg-primary-hover text-white font-semibold py-4 px-8 rounded-xl shadow-lg shadow-primary/25 transition-all duration-200 mb-4 cursor-pointer"
        >
          Open in Recall People
        </button>
        <p class="text-text-muted text-sm mt-4">
          Don't have the app?
          <a href="/" class="font-semibold text-primary hover:text-primary-hover">
            Back to home
          </a>
        </p>
      </div>`;
  }

  if (mount) {
    if (!token) {
      mount.innerHTML = noTokenView();
    } else {
      const deepLinkUrl = `${DEEP_LINK_SCHEME}reset-password?token=${token}`;
      mount.innerHTML = openingView();
      window.location.href = deepLinkUrl;

      window.setTimeout(() => {
        mount.innerHTML = attemptedView();
        const openBtn = document.getElementById("rp-open");
        openBtn?.addEventListener("click", () => {
          window.location.href = `${DEEP_LINK_SCHEME}reset-password?token=${token}`;
        });
      }, DEEP_LINK_DELAY_MS);
    }
  }
</script>
