#!/usr/bin/env bash
# Layout, keyboard and API conventions are enforced by tests that read source
# files, so they only protect what is committed if they run here.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

if ! command -v npm >/dev/null 2>&1 && [ -s "$HOME/.nvm/nvm.sh" ]; then
  # Hooks run in a non-interactive shell, where nvm has not been sourced.
  . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1
fi

status=0

for workspace in frontend backend; do
  if [ -z "$(git diff --cached --name-only --diff-filter=ACMR -- "$repo_root/$workspace")" ]; then
    continue
  fi

  echo "▶ $workspace"
  (cd "$repo_root/$workspace" && npm test --silent) || status=1
done

exit "$status"
